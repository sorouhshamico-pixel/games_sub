# Copy to .env and fill in real values. Never commit the real .env file.

# --- Core ---
NODE_ENV=development

# --- Database ---
DATABASE_URL="postgresql://gcc_store:gcc_store_dev_password@localhost:5432/gcc_store?schema=public"

# --- Redis / queues ---
REDIS_URL="redis://localhost:6379"

# --- API ---
PORT=4000
WEB_APP_ORIGIN="http://localhost:3000"

# --- Web app ---
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Auth ---
# Sessions are opaque server-side tokens (Session table), not JWTs — nothing
# to configure here. Set these before seeding any shared/production
# environment; the seed script falls back to a loudly-logged dev-only
# password if ADMIN_SEED_PASSWORD is unset.
ADMIN_SEED_EMAIL="admin@example.com"
ADMIN_SEED_PASSWORD=""

# --- Payment gateway (Moyasar) ---
# Sandbox keys from https://moyasar.com dashboard. Leave MOYASAR_ENABLED=false
# to keep the mock payment adapter active until sandbox keys are supplied.
MOYASAR_ENABLED=false
MOYASAR_PUBLISHABLE_KEY=""
MOYASAR_SECRET_KEY=""
MOYASAR_WEBHOOK_SECRET=""

# --- Fulfillment provider(s) ---
# The Mock provider is active by default (see packages/db/prisma/seed.ts).
# Add real provider credentials here once a signed agreement is in place —
# see docs/PROVIDER_INTEGRATION.md.

# --- Notifications ---
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMS_PROVIDER_API_KEY=""
WHATSAPP_BUSINESS_API_TOKEN=""

# --- Object storage (S3-compatible) ---
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Observability ---
SENTRY_DSN=""

# --- ZATCA (Phase 6 — leave unset until legal/accounting sign-off) ---
ZATCA_ENABLED=false
